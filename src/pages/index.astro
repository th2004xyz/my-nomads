---
// src/pages/index.astro
// Homepage — data product showcase.

import BaseLayout       from "../layouts/BaseLayout.astro";
import Navbar           from "../components/homepage/Navbar.astro";
import Hero             from "../components/homepage/Hero.astro";
import CTACommunity     from "../components/homepage/CTACommunity.astro";
import Footer           from "../components/shared/Footer.astro";

const products = [
  {
    icon: "📊",
    title: "Zephyr Forge",
    tag: "Available",
    highlight: "Currently accepting orders",
    description: "Curated crypto OHLCV dataset for niche chains. Multi-exchange aligned, AI-ready Parquet files.",
    href: "/products/zephyr-forge",
  },
  {
    icon: "🌐",
    title: "Zephyr Translate",
    tag: "Available",
    description: "Windows desktop AI translation for long documents. Freemium, BYOK — your docs and keys stay on your machine.",
    href: "/products/zephyr-translate",
  },
  {
    icon: "🔌",
    title: "Zephyr Data Factory",
    tag: "Coming Soon",
    description: "Dataset API subscription — programmatic access to curated data with usage-based billing.",
    href: "/products/zephyr-data-factory",
  },
];
---

<BaseLayout
  title="Zephyr — Curated Data Products for AI Builders"
  description="Curated crypto datasets, on-demand data APIs, and domain-specific AI tools for researchers, quants, and builders."
>
  <Navbar />
  <Hero />

  <section class="section" id="products">
    <div class="section-header">
      <div class="section-label">What We Build</div>
      <h2 class="section-title">Data Products</h2>
    </div>

    <div class="card-grid">
      {products.map((p) => (
        <a href={p.href} class="card product-card">
          <div class="product-card-header">
            <span class="product-icon">{p.icon}</span>
            <span class={`product-tag ${p.tag === 'Available' ? 'tag-available' : 'tag-coming'}`}>{p.tag}</span>
          </div>
          <h3>{p.title}</h3>
          {p.highlight && <span class="product-highlight">{p.highlight}</span>}
          <p>{p.description}</p>
          <span class="product-link">Learn more →</span>
        </a>
      ))}
    </div>
  </section>

  <CTACommunity />
  <Footer />
</BaseLayout>

<style>
  .product-card {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.5rem;
    border: 1px solid #eee;
    border-radius: 10px;
    transition: border-color 0.2s;
  }
  .product-card:hover {
    border-color: #000;
  }
  .product-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .product-icon {
    font-size: 1.5rem;
  }
  .product-tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }
  .tag-available {
    background: #22c55e;
    color: #fff;
  }
  .tag-coming {
    background: #f59e0b;
    color: #fff;
  }
  .product-highlight {
    display: inline-block;
    margin-top: 0.4rem;
    padding: 0.18rem 0.55rem;
    background: rgba(255, 138, 61, 0.14);
    border: 1px solid rgba(255, 138, 61, 0.3);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #ffb27a;
  }
  .product-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-blue, #2563eb);
  }
</style>
