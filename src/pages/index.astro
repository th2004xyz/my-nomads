---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout>

  <!-- ─── Hero Section ─────────────────────────────────────────── -->
  <section class="bg-white pt-24 pb-20 px-8 md:px-20">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-12">

      <!-- Text -->
      <div class="flex-1 max-w-xl">
        <h1 class="text-4xl md:text-5xl font-extrabold text-blue-600 mb-5 leading-tight">
          From Corporate Life<br class="hidden md:block" /> to Freedom.
          <span class="block text-gray-800 mt-1">Build Your Digital Nomad Life in Public.</span>
        </h1>
        <p class="text-gray-600 text-lg md:text-xl mb-8 leading-relaxed">
          Learn, Explore, and Sell Digital Products — Step by Step.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/journey"
             class="px-6 py-3 bg-blue-600 text-white rounded-lg shadow-md hover:bg-blue-500 transition text-center font-medium">
            Explore Guides
          </a>
          <a href="/products"
             class="px-6 py-3 border border-blue-600 text-blue-600 rounded-lg hover:bg-blue-50 transition text-center font-medium">
            Browse Products
          </a>
        </div>
      </div>

      <!-- Illustration -->
      <div class="flex-1 flex justify-center">
        <img
          src="/hero-illustration.png"
          alt="Digital Nomad Illustration"
          class="rounded-2xl max-w-full w-full md:max-w-md"
        />
      </div>

    </div>
  </section>

  <!-- ─── Entry Cards Section ──────────────────────────────────── -->
  <!-- 浅蓝背景，与 Hero 白色自然区分 -->
  <section class="bg-blue-50 px-8 md:px-20 py-16">
    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-8">

      <!-- Journey -->
      <div class="bg-white rounded-2xl shadow-md p-6 hover:-translate-y-1 hover:shadow-xl transition-all duration-200 cursor-pointer">
        <img src="/assets/icons/journey-icon.svg" alt="" class="w-12 h-12 mb-4" />
        <h3 class="text-xl font-semibold text-blue-600 mb-2">Building in Public</h3>
        <p class="text-gray-500 text-sm leading-relaxed">Follow my step-by-step digital nomad journey and learn from real experiences.</p>
        <a href="/journey" class="mt-5 inline-block text-blue-600 font-medium text-sm hover:underline">
          Enter &rarr;
        </a>
      </div>

      <!-- Shop -->
      <div class="bg-white rounded-2xl shadow-md p-6 hover:-translate-y-1 hover:shadow-xl transition-all duration-200 cursor-pointer">
        <img src="/assets/icons/shop-icon.svg" alt="" class="w-12 h-12 mb-4" />
        <h3 class="text-xl font-semibold text-green-600 mb-2">Digital Products</h3>
        <p class="text-gray-500 text-sm leading-relaxed">Explore AI-powered templates, tools, and resources to boost your productivity.</p>
        <a href="/products" class="mt-5 inline-block text-green-600 font-medium text-sm hover:underline">
          Enter &rarr;
        </a>
      </div>

      <!-- Resources -->
      <div class="bg-white rounded-2xl shadow-md p-6 hover:-translate-y-1 hover:shadow-xl transition-all duration-200 cursor-pointer">
        <img src="/assets/icons/resources-icon.svg" alt="" class="w-12 h-12 mb-4" />
        <h3 class="text-xl font-semibold text-orange-500 mb-2">Tools & Guides</h3>
        <p class="text-gray-500 text-sm leading-relaxed">Find curated guides, tools, and tips to help you succeed as a digital nomad entrepreneur.</p>
        <a href="/resources" class="mt-5 inline-block text-orange-500 font-medium text-sm hover:underline">
          Enter &rarr;
        </a>
      </div>

    </div>
  </section>

  <!-- ─── News Section ─────────────────────────────────────────── -->
  <!-- 回到白色，形成节奏 -->
  <section class="bg-white px-8 md:px-20 py-20">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-800 mb-2 text-center">Latest Digital Nomad News</h2>
      <p class="text-gray-400 text-center mb-10 text-sm">Curated updates for remote workers and entrepreneurs</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

        <div class="bg-gray-100 rounded-2xl p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200 border border-gray-100">
          <span class="text-orange-500 text-xs font-semibold uppercase tracking-wide">AI Tool</span>
          <h3 class="text-base font-semibold text-gray-800 mt-2 mb-2 leading-snug">New Notion Plugin for Remote Productivity</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Boost your workflow with the latest plugin optimized for digital nomads.</p>
        </div>

        <div class="bg-gray-100 rounded-2xl p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200 border border-gray-100">
          <span class="text-green-600 text-xs font-semibold uppercase tracking-wide">Startup</span>
          <h3 class="text-base font-semibold text-gray-800 mt-2 mb-2 leading-snug">Remote Work Tools Funded $2M</h3>
          <p class="text-gray-500 text-sm leading-relaxed">A startup raises $2M to develop tools supporting remote entrepreneurs worldwide.</p>
        </div>

        <div class="bg-gray-100 rounded-2xl p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200 border border-gray-100">
          <span class="text-blue-600 text-xs font-semibold uppercase tracking-wide">Tech Update</span>
          <h3 class="text-base font-semibold text-gray-800 mt-2 mb-2 leading-snug">GitHub Trending: 5 Remote Work Repos</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Top trending repos this week for freelancers and digital nomads.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── Tools Section ────────────────────────────────────────── -->
  <!-- 浅灰背景，再次切换 -->
  <section class="bg-gray-100 px-8 md:px-20 py-20">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-800 mb-2 text-center">Recommended Tools</h2>
      <p class="text-gray-400 text-center mb-10 text-sm">Hand-picked tools to build your nomad workflow</p>
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-6">

        <div class="bg-white rounded-2xl shadow-sm p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200 text-center border border-gray-100">
          <img src="/assets/icons/tool1.svg" alt="" class="w-12 h-12 mx-auto mb-4" />
          <h3 class="font-semibold text-gray-800 text-sm mb-1">AI Content Assistant</h3>
          <p class="text-gray-400 text-xs leading-relaxed">Automate your writing and workflow efficiently.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200 text-center border border-gray-100">
          <img src="/assets/icons/tool2.svg" alt="" class="w-12 h-12 mx-auto mb-4" />
          <h3 class="font-semibold text-gray-800 text-sm mb-1">Notion Templates</h3>
          <p class="text-gray-400 text-xs leading-relaxed">Organize your projects and digital products easily.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200 text-center border border-gray-100">
          <img src="/assets/icons/tool3.svg" alt="" class="w-12 h-12 mx-auto mb-4" />
          <h3 class="font-semibold text-gray-800 text-sm mb-1">Remote Job Boards</h3>
          <p class="text-gray-400 text-xs leading-relaxed">Find verified remote work opportunities worldwide.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200 text-center border border-gray-100">
          <img src="/assets/icons/tool4.svg" alt="" class="w-12 h-12 mx-auto mb-4" />
          <h3 class="font-semibold text-gray-800 text-sm mb-1">Time Tracking App</h3>
          <p class="text-gray-400 text-xs leading-relaxed">Manage your freelance projects and productivity.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── Products Section ─────────────────────────────────────── -->
  <!-- 回到白色 -->
  <section class="bg-white px-8 md:px-20 py-20">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-800 mb-2 text-center">Featured Products</h2>
      <p class="text-gray-400 text-center mb-10 text-sm">Digital tools built for nomads, by a nomad</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">

        <div class="bg-gray-100 rounded-2xl p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200 border border-gray-100 flex flex-col">
          <h3 class="text-base font-semibold text-gray-800 mb-1">The Tao of Flow</h3>
          <p class="text-orange-500 text-sm font-medium mb-3">$19 — Notion Template</p>
          <p class="text-gray-500 text-sm leading-relaxed mb-5 flex-1">Boost productivity using Taoist principles of flow and balance.</p>
          <a href="/products/tao-of-flow"
             class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-500 transition text-center text-sm font-medium">
            Buy Now
          </a>
        </div>

        <div class="bg-gray-100 rounded-2xl p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200 border border-gray-100 flex flex-col">
          <h3 class="text-base font-semibold text-gray-800 mb-1">7 Habits 12-Week Template</h3>
          <p class="text-orange-500 text-sm font-medium mb-3">$19 — Notion Template</p>
          <p class="text-gray-500 text-sm leading-relaxed mb-5 flex-1">Implement Covey's 7 habits with a structured 12-week system.</p>
          <a href="/products/7-habits"
             class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-500 transition text-center text-sm font-medium">
            Buy Now
          </a>
        </div>

        <div class="bg-gray-100 rounded-2xl p-6 hover:-translate-y-1 hover:shadow-md transition-all duration-200 border border-gray-100 flex flex-col">
          <h3 class="text-base font-semibold text-gray-800 mb-1">Remote Productivity Pack</h3>
          <p class="text-orange-500 text-sm font-medium mb-3">$29 — Bundle</p>
          <p class="text-gray-500 text-sm leading-relaxed mb-5 flex-1">Collection of templates & tools built for digital nomads on the go.</p>
          <a href="/products/productivity-pack"
             class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-500 transition text-center text-sm font-medium">
            Buy Now
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── Newsletter / Community Section ──────────────────────── -->
  <!-- 深蓝背景强收尾，高 CTA 权重 -->
  <section class="bg-slate-700 py-20 px-8 md:px-20">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-white mb-3">Join the Community</h2>
      <p class="text-blue-100 mb-8 text-base leading-relaxed">
        Subscribe to get the latest digital nomad tips, tools, and product updates — no spam, ever.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <input
          type="email"
          placeholder="Enter your email"
          class="px-4 py-3 rounded-lg border border-slate-400 flex-1 max-w-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-white"
        />
        <button
          type="button"
          class="px-6 py-3 bg-white text-blue-600 font-semibold rounded-lg hover:bg-blue-50 transition shadow-md"
          onclick="alert('Thanks for subscribing!')">
          Subscribe
        </button>
      </div>
    </div>
  </section>

</Layout>
