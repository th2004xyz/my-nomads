---
// src/pages/index.astro
// Homepage — data product showcase.

import BaseLayout       from "../layouts/BaseLayout.astro";
import Navbar           from "../components/homepage/Navbar.astro";
import Hero             from "../components/homepage/Hero.astro";
import CTACommunity     from "../components/homepage/CTACommunity.astro";
import Footer           from "../components/shared/Footer.astro";

// Inline SVG icon paths (Lucide-style)
const iconDatabase = `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>`;
const iconLanguages = `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/></svg>`;

const products = [
  {
    icon: iconDatabase,
    title: "Zephyr Forge",
    tag: "Available",
    eyebrow: "Datasets",
    description: "Curated crypto OHLCV dataset for niche chains. Multi-exchange aligned, AI-ready Parquet files with full provenance.",
    href: "/products/zephyr-forge",
    cta: "Browse datasets",
  },
  {
    icon: iconLanguages,
    title: "Zephyr Translate",
    tag: "Available",
    eyebrow: "Case study",
    description: "Windows desktop AI translation for long documents. Freemium, BYOK — your docs and keys stay on your machine.",
    href: "/products/zephyr-translate",
    cta: "See the case study",
  },
];
---

<BaseLayout
  title="Zephyr — Curated Data Products for AI Builders"
  description="Curated crypto datasets, on-demand data APIs, and domain-specific AI tools for researchers, quants, and builders."
>
  <Navbar />
  <Hero />

  <section class="section" id="products">
    <div class="section-header">
      <div class="section-label">Products</div>
      <h2 class="section-title">A unified data stack for AI</h2>
    </div>

    <div class="card-grid">
      {products.map((p) => (
        <a href={p.href} class="card product-card" style="display:flex; flex-direction:column;">
          <div class="product-card-header">
            <span class="product-icon" set:html={p.icon} />
            <span class={`product-tag ${p.tag === 'Available' ? 'tag-available' : 'tag-coming'}`}>{p.tag}</span>
          </div>
          <p class="section-label" style="margin-bottom:0.25rem; text-align:left;">{p.eyebrow}</p>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <span class="product-link">{p.cta} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section" style="text-align:center; max-width:720px;">
    <h2 class="section-title">Built on a proven methodology</h2>
    <p class="section-subtitle">
      Every dataset we ship is backed by rigorous cleaning, anomaly detection, and full provenance tracking.
    </p>
    <a href="/about" class="product-link" style="margin-top:1rem;">
      Learn about our methodology →
    </a>
  </section>

  <CTACommunity />
  <Footer />
</BaseLayout>
