---
// src/pages/index.astro
// Homepage — assembles all section components in order.

import BaseLayout       from "../layouts/BaseLayout.astro";
import Navbar           from "../components/homepage/Navbar.astro";
import Hero             from "../components/homepage/Hero.astro";
import Vision           from "../components/homepage/Vision.astro";
import CurrentBuilds    from "../components/homepage/CurrentBuilds.astro";
import KnowledgeSystems from "../components/homepage/KnowledgeSystems.astro";
import RuntimeKits      from "../components/homepage/RuntimeKits.astro";
import CTACommunity     from "../components/homepage/CTACommunity.astro";
import Footer           from "../components/shared/Footer.astro";
---
<BaseLayout
  title="Zephyr — AI-Native Digital Life Hub"
  description="Workflows, runtime systems, AI tools, and digital leverage for solo builders and digital nomads."
>
  <Navbar />
  <Hero />
  <Vision />
  <CurrentBuilds />

  <!-- KnowledgeSystems contains its own <section> wrapper -->
  <!-- RuntimeKits renders as a sub-section (.kits-divider) inside the knowledge flow -->
  <KnowledgeSystems />
  <div class="section" style="padding-top: 0; max-width: var(--max-w); margin: 0 auto;">
    <RuntimeKits />
  </div>

  <CTACommunity />
  <Footer />
</BaseLayout>
