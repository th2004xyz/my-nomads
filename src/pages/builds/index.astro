---
import { getCollection } from 'astro:content';

const allBuilds = await getCollection('builds');
const builds = allBuilds.sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
}
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Build Log — Zephyr</title>
		<style>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			:root {
				--bg: #0a0a0a;
				--surface: #111111;
				--border: #1f1f1f;
				--text: #e8e8e8;
				--muted: #555;
				--accent: #e8e8e8;
				--tag-bg: #1a1a1a;
				--tag-text: #888;
				--font-mono: 'JetBrains Mono', 'Fira Code', monospace;
				--font-sans: 'Geist', 'Inter', system-ui, sans-serif;
			}

			body {
				background: var(--bg);
				color: var(--text);
				font-family: var(--font-sans);
				min-height: 100vh;
				padding: 0 1.5rem;
			}

			.container {
				max-width: 680px;
				margin: 0 auto;
				padding: 5rem 0 6rem;
			}

			header {
				margin-bottom: 3.5rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--border);
			}

			.label {
				font-family: var(--font-mono);
				font-size: 0.65rem;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--muted);
				margin-bottom: 1rem;
			}

			h1 {
				font-size: 1.4rem;
				font-weight: 500;
				color: var(--text);
				letter-spacing: -0.02em;
			}

			.build-list {
				display: flex;
				flex-direction: column;
				gap: 0;
			}

			.build-card {
				display: block;
				padding: 1.5rem 0;
				border-bottom: 1px solid var(--border);
				text-decoration: none;
				color: inherit;
				transition: opacity 0.15s ease;
			}

			.build-card:hover {
				opacity: 0.7;
			}

			.card-meta {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 0.5rem;
			}

			.card-date {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--muted);
				letter-spacing: 0.05em;
			}

			.card-tags {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
			}

			.tag {
				font-family: var(--font-mono);
				font-size: 0.62rem;
				color: var(--tag-text);
				background: var(--tag-bg);
				border: 1px solid var(--border);
				padding: 0.15rem 0.5rem;
				border-radius: 3px;
				letter-spacing: 0.04em;
			}

			.card-title {
				font-size: 0.95rem;
				font-weight: 500;
				color: var(--text);
				margin-bottom: 0.4rem;
				letter-spacing: -0.01em;
			}

			.card-summary {
				font-size: 0.85rem;
				color: var(--muted);
				line-height: 1.55;
			}

			.empty {
				font-size: 0.85rem;
				color: var(--muted);
				font-family: var(--font-mono);
				padding: 2rem 0;
			}
		</style>
	</head>
	<body>
		<div class="container">
			<header>
				<p class="label">Zephyr / Runtime</p>
				<h1>Build Log</h1>
			</header>

			<div class="build-list">
				{
					builds.length === 0 ? (
						<p class="empty">No build logs yet.</p>
					) : (
						builds.map((build) => (
							<a class="build-card" href={`/builds/${build.id}`}>
								<div class="card-meta">
									<span class="card-date">{formatDate(build.data.date)}</span>
									<div class="card-tags">
										{build.data.tags.map((tag) => (
											<span class="tag">{tag}</span>
										))}
									</div>
								</div>
								<p class="card-title">{build.data.title}</p>
								<p class="card-summary">{build.data.summary}</p>
							</a>
						))
					)
				}
			</div>
		</div>
	</body>
</html>
