---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/homepage/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
---

<BaseLayout
  title="Tools | Zephyr"
  description="Free long-text translation. Domain-specific accuracy powered by Zephyr curated datasets."
>
  <Navbar />
  <main>
    <section class="tools-hero">
      <h1>Zeph-Trans</h1>
      <p class="hero-tagline">Long-text translation. Free for general use. Professional for your domain.</p>
    </section>
    <section class="tool-section">
      <div class="tool-card highlight">
        <div class="tool-header">
          <div>
            <div class="tool-badge free">Free</div>
            <h2>General Translation</h2>
          </div>
        </div>
        <p class="tool-desc">Translate documents up to 200K+ characters. Powered by Claude's million-token context window. No chunking, no context loss.</p>
        <ul class="tool-features">
          <li>200K+ character single-session</li>
          <li>Preserves Markdown and formatting</li>
          <li>Multiple output languages</li>
        </ul>
        <div class="tool-cta">
          <span class="tool-status">Coming soon - free to use</span>
          <a href="#notify" class="btn-primary">Notify Me</a>
        </div>
      </div>
      <div class="tool-card">
        <div class="tool-header">
          <div>
            <div class="tool-badge pro">Professional</div>
            <h2>Domain-Specific Translation</h2>
          </div>
        </div>
        <p class="tool-desc">Same engine, powered by Zephyr curated datasets. Crypto, finance, technical - our data makes the difference.</p>
        <div class="comparison">
          <h3>Translation comparison</h3>
          <div class="compare-cards">
            <div class="compare-card generic">
              <span class="compare-label">Generic AI</span>
              <p class="compare-text">Gas fees have increased.</p>
              <p class="compare-trans">Fuel cost increased.</p>
              <p class="compare-note">Gas translated as fuel.</p>
            </div>
            <div class="compare-card">
              <span class="compare-label">Zeph-Trans</span>
              <p class="compare-text">Gas fees have increased.</p>
              <p class="compare-trans">Gas fee increased.</p>
              <p class="compare-note">Gas correctly preserved.</p>
            </div>
          </div>
        </div>
        <ul class="tool-features">
          <li>Crypto, finance domain glossaries</li>
          <li>Custom terminology dictionaries</li>
          <li>Multi-model: Claude, DeepSeek, GPT-4</li>
        </ul>
        <div class="tool-cta">
          <span class="tool-status">Coming soon - $9/mo</span>
          <a href="#notify" class="btn-primary">Notify Me</a>
        </div>
      </div>
    </section>
    <section class="tools-note">
      <h2>Why a free translation tool?</h2>
      <p>The best way to prove our datasets work is to let you experience a product powered by them. Free tool is the demo. Professional version is the product.</p>
      <p>Questions? <a href="mailto:Yakovxia@gmail.com">Yakovxia@gmail.com</a></p>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  main { max-width: 860px; margin: 0 auto; padding: 5rem 1rem 2rem; }
  .tools-hero { text-align: center; padding: 3rem 0 2rem; }
  .tools-hero h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 0.75rem; }
  .hero-tagline { font-size: 1.15rem; color: var(--color-text-muted); max-width: 500px; margin: 0 auto; }
  .tool-section { display: flex; flex-direction: column; gap: 1.5rem; padding: 2rem 0; }
  .tool-card { padding: 1.5rem 2rem; border: 1px solid var(--color-border-soft); border-radius: var(--radius-md); background: var(--color-card); }
  .tool-card.highlight { border-color: rgba(77, 124, 254, 0.35); }
  .tool-header { display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1rem; }
  .tool-badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.7rem; font-weight: 600; margin-bottom: 0.3rem; }
  .tool-badge.free { background: var(--color-blue); color: #fff; }
  .tool-badge.pro { background: #22c55e; color: #fff; }
  .tool-header h2 { font-size: 1.3rem; margin: 0; }
  .tool-desc { color: var(--color-text-muted); line-height: 1.6; margin-bottom: 1rem; }
  .tool-features { padding-left: 1.25rem; margin-bottom: 1.5rem; color: var(--color-text-muted); }
  .tool-features li { margin-bottom: 0.35rem; font-size: 0.9rem; }
  .tool-cta { display: flex; align-items: center; justify-content: space-between; padding-top: 1rem; border-top: 1px solid var(--color-border-soft); }
  .tool-status { color: var(--color-text-faint); font-size: 0.85rem; }
  .btn-primary { display: inline-block; background: var(--color-white); color: #000; padding: 0.6rem 1.2rem; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .comparison { margin: 1rem 0 1.5rem; }
  .comparison h3 { font-size: 0.85rem; color: var(--color-text-faint); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem; }
  .compare-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .compare-card { padding: 0.75rem 1rem; border-radius: 6px; background: rgba(10, 13, 20, 0.5); border: 1px solid var(--color-border-soft); }
  .compare-card.generic { opacity: 0.7; }
  .compare-label { display: block; font-size: 0.7rem; font-weight: 600; color: var(--color-text-faint); margin-bottom: 0.5rem; text-transform: uppercase; }
  .compare-text { font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: 0.35rem; font-style: italic; }
  .compare-trans { font-size: 0.85rem; color: var(--color-white); margin-bottom: 0.35rem; }
  .compare-note { font-size: 0.72rem; color: var(--color-text-faint); }
  .compare-card:not(.generic) .compare-note { color: #22c55e; }
  .tools-note { text-align: center; padding: 3rem 0; border-top: 1px solid var(--color-border-soft); }
  .tools-note h2 { font-size: 1.3rem; margin-bottom: 0.75rem; }
  .tools-note p { color: var(--color-text-muted); max-width: 560px; margin: 0 auto 1rem; line-height: 1.6; }
  .tools-note a { color: var(--color-blue); }
  @media (max-width: 600px) { .compare-cards { grid-template-columns: 1fr; } .tool-cta { flex-direction: column; gap: 0.75rem; text-align: center; } }
</style>