---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/homepage/Navbar.astro";
import Footer from "../../components/shared/Footer.astro";
---

<BaseLayout
  title="Zephyr Forge — Crypto OHLCV Dataset"
  description="Curated crypto OHLCV dataset for niche chains. Multi-exchange aligned, compliance-ready Parquet files for AI training and quant research."
>
  <Navbar />
  <main>
    <section class="product-hero">
      <div class="product-badge">Available Now</div>
      <h1>Zephyr Forge</h1>
      <p class="product-tagline">Niche Chain OHLCV Dataset — Multi-Exchange Aligned, AI-Ready</p>
      <a href="https://gumroad.com" class="btn-primary">Buy Now — $29</a>
    </section>

    <section class="product-section">
      <h2>Overview</h2>
      <p>
        Zephyr Forge is a curated cryptocurrency OHLCV dataset covering four niche Layer-1 chains
        (Sui, Aptos, Arbitrum, Optimism) across four major exchanges (Binance, OKX, Bybit, Coinbase).
      </p>
      <p>
        Unlike generic crypto datasets, Forge applies multi-exchange alignment — each data point is
        benchmarked against a median price across all four exchanges, with outliers flagged at 3%
        deviation. This gives you clean, reliable data ready for backtesting, AI model training, or
        quantitative research.
      </p>
      <p>
        Every dataset ships with a full provenance report and a NO-PII compliance declaration,
        meeting institutional data governance requirements.
      </p>
    </section>

    <section class="product-section">
      <h2>Key Features</h2>
      <ul class="feature-list">
        <li><strong>Multi-Exchange Alignment</strong> — Median benchmark across 4 exchanges, 3% deviation flags</li>
        <li><strong>Outlier Detection</strong> — 5-sigma wick filter + 6-candle stall detection</li>
        <li><strong>Three Timeframes</strong> — 1 hour, 4 hour, and 1 day candles</li>
        <li><strong>Full Provenance</strong> — Source manifest, audit trail, and compliance report included</li>
        <li><strong>Parquet Format</strong> — Hive-partitioned by chain/symbol/timeframe/year/month, ready for DuckDB/Pandas</li>
      </ul>
    </section>

    <section class="product-section">
      <h2>Specifications</h2>
      <div class="spec-grid">
        <div class="spec-item">
          <span class="spec-label">Chains</span>
          <span class="spec-value">SUI, APT, ARB, OP</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Exchanges</span>
          <span class="spec-value">Binance, OKX, Bybit, Coinbase</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Timeframes</span>
          <span class="spec-value">1h, 4h, 1d</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Date Range</span>
          <span class="spec-value">2023-01-01 to 2024-07-10</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Total Rows</span>
          <span class="spec-value">414,427</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">File Size</span>
          <span class="spec-value">64.72 MB (zipped)</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Format</span>
          <span class="spec-value">Parquet (Hive-partitioned)</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Files</span>
          <span class="spec-value">14,823</span>
        </div>
      </div>
    </section>

    <section class="product-section pricing">
      <h2>Pricing</h2>
      <div class="price-card">
        <span class="price">$29</span>
        <span class="price-note">One-time purchase. Lifetime access.</span>
      </div>
      <a href="https://gumroad.com" class="btn-primary">Get Zephyr Forge →</a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .product-hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }
  .product-badge {
    display: inline-block;
    background: #22c55e;
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .product-hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }
  .product-tagline {
    font-size: 1.15rem;
    color: #666;
    margin-bottom: 1.5rem;
  }
  .btn-primary {
    display: inline-block;
    background: #000;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
  }
  .product-section {
    padding: 2rem 0;
    border-top: 1px solid #eee;
  }
  .product-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .product-section p {
    color: #444;
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }
  .feature-list {
    list-style: none;
    padding: 0;
  }
  .feature-list li {
    padding: 0.5rem 0;
    color: #444;
  }
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .spec-item {
    padding: 0.75rem;
    background: #f9f9f9;
    border-radius: 6px;
  }
  .spec-label {
    display: block;
    font-size: 0.8rem;
    color: #888;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }
  .spec-value {
    font-weight: 600;
  }
  .pricing {
    text-align: center;
  }
  .price-card {
    margin-bottom: 1.5rem;
  }
  .price {
    font-size: 3rem;
    font-weight: 800;
    display: block;
  }
  .price-note {
    color: #666;
    font-size: 0.95rem;
  }
</style>