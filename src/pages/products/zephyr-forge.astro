---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/homepage/Navbar.astro";
import Footer from "../../components/shared/Footer.astro";

// TODO: 收到真实 USDT-TRC20 地址后替换这一处即可，全文件只有这一个来源
const USDT_TRC20_ADDRESS = "TDkzRVJXwfQYyetuLsH8YB738ug3xHr3K1";
const ORDER_EMAIL = "orders@zephyrdn.com";
const HUGGINGFACE_SAMPLE_URL = "https://huggingface.co/datasets/zephyrdn/zephyr-forge-multi-exchange-ohlcv";
---

<BaseLayout
  title="Zephyr Forge — Crypto OHLCV Dataset"
  description="Curated crypto OHLCV dataset for niche chains. Multi-exchange aligned, compliance-ready Parquet files for AI training and quant research."
>
  <Navbar />
  <main>
    <section class="product-hero">
      <div class="product-badge">v2.0 — Available Now</div>
      <h1>Zephyr Forge</h1>
      <p class="product-tagline">Niche Chain OHLCV Dataset — Multi-Exchange Aligned, AI-Ready</p>
      <div class="hero-actions">
        <a href="#payment" class="btn-primary">Order Now — $29</a>
        <a href={HUGGINGFACE_SAMPLE_URL} target="_blank" rel="noopener noreferrer" class="btn-secondary">Download Free Sample →</a>
      </div>
    </section>

    <section class="product-section">
      <h2>Overview</h2>
      <p>
        Zephyr Forge is a curated cryptocurrency OHLCV dataset covering four niche Layer-1 chains
        (Sui, Aptos, Arbitrum, Optimism) across four major exchanges (Binance, OKX, Bybit, Coinbase).
      </p>
      <p>
        Unlike generic crypto datasets, Forge applies multi-exchange alignment — each data point is
        benchmarked against a median price across all four exchanges, with outliers flagged at 3%
        deviation. This gives you clean, reliable data ready for backtesting, AI model training, or
        quantitative research.
      </p>
      <p>
        Every dataset ships with a full provenance report and a NO-PII compliance declaration,
        meeting institutional data governance requirements.
      </p>
    </section>

    <section class="product-section">
      <h2>Key Features</h2>
      <ul class="feature-list">
        <li><strong>Multi-Exchange Alignment</strong> — Median benchmark across 4 exchanges, 3% deviation flags</li>
        <li><strong>Outlier Detection</strong> — 5-sigma wick filter + 6-candle stall detection</li>
        <li><strong>Three Timeframes</strong> — 1 hour, 4 hour, and 1 day candles</li>
        <li><strong>Full Provenance</strong> — Source manifest, audit trail, and compliance report included</li>
        <li><strong>Parquet Format</strong> — Hive-partitioned by chain/symbol/timeframe/year/month, ready for DuckDB/Pandas</li>
      </ul>
    </section>

    <section class="product-section">
      <h2>Specifications</h2>
      <div class="spec-grid">
        <div class="spec-item">
          <span class="spec-label">Chains</span>
          <span class="spec-value">SUI, APT, ARB, OP</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Exchanges</span>
          <span class="spec-value">Binance, OKX, Bybit, Coinbase</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Timeframes</span>
          <span class="spec-value">1h, 4h, 1d</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Date Range</span>
          <span class="spec-value">2023-01-01 to 2026-07-16</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Total Rows</span>
          <span class="spec-value">421,918</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Raw Size</span>
          <span class="spec-value">167.11 MB</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Format</span>
          <span class="spec-value">Parquet (Hive-partitioned)</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">Files</span>
          <span class="spec-value">14,907</span>
        </div>
      </div>
    </section>

    <section class="product-section payment-section" id="payment">
      <h2>How to Order</h2>
      <p>
        Two ways to pay — pick whichever fits your workflow. After payment, email your transaction
        hash or transfer receipt to <a href={`mailto:${ORDER_EMAIL}`}>{ORDER_EMAIL}</a> and you'll
        receive a signed download link within 24 hours.
      </p>
      <p class="payment-instruction">
        Subject line: <code>Forge Order — [your email]</code>. Include your
        transaction hash (for USDT) or transfer screenshot (for wire) in the
        email body.
      </p>
      <div class="payment-options">
        <div class="payment-card">
          <h3>Stablecoin — USDT (TRC20)</h3>
          <p class="payment-address">{USDT_TRC20_ADDRESS}</p>
          <p class="payment-note">Send the exact amount, then email the transaction hash to confirm.</p>
        </div>
        <div class="payment-card">
          <h3>Wire Transfer / Invoice</h3>
          <p class="payment-note">Need a formal invoice or bank wire for your company's procurement process?</p>
          <a href={`mailto:${ORDER_EMAIL}?subject=Zephyr Forge — Wire Transfer Inquiry`} class="btn-secondary">Contact for Invoice →</a>
        </div>
      </div>
    </section>

    <section class="product-section pricing">
      <h2>Pricing</h2>
      <div class="price-card">
        <span class="price">$29</span>
        <span class="price-note">One-time purchase. Lifetime access to v2.0 dataset.</span>
      </div>
      <a href="#payment" class="btn-primary">Get Zephyr Forge →</a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 5rem 1rem 2rem;
  }
  .product-hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }
  .product-badge {
    display: inline-block;
    background: rgba(52, 199, 89, 0.12);
    color: #248a3d;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
    font-family: var(--font-serif);
  }
  .product-hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }
  .product-tagline {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .product-section {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border-soft);
  }
  .product-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .product-section p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }
  .product-section a {
    color: var(--color-blue);
  }
  .feature-list {
    list-style: none;
    padding: 0;
  }
  .feature-list li {
    padding: 0.5rem 0;
    color: var(--color-text-muted);
  }
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .spec-item {
    padding: 0.75rem;
    background: var(--color-card);
    border-radius: 6px;
    border: 1px solid var(--color-border-soft);
  }
  .spec-label {
    display: block;
    font-size: 0.8rem;
    color: var(--color-text-faint);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }
  .spec-value {
    font-weight: 600;
  }
  .payment-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .payment-card {
    padding: 1.25rem;
    background: var(--color-card);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
  }
  .payment-card h3 {
    font-size: 1rem;
    color: var(--color-white);
    margin-bottom: 0.6rem;
  }
  .payment-address {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    background: var(--secondary);
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    word-break: break-all;
    color: var(--foreground);
    margin-bottom: 0.6rem;
  }
  .payment-note {
    font-size: 0.85rem;
    color: var(--color-text-faint);
    margin-bottom: 0;
  }
  .payment-instruction {
    font-size: 0.85rem;
    color: var(--color-text-faint);
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-border-soft);
    margin-top: 0.75rem;
  }
  .pricing {
    text-align: center;
  }
  .price-card {
    margin-bottom: 1.5rem;
  }
  .price {
    font-size: 3rem;
    font-weight: 800;
    display: block;
  }
  .price-note {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  @media (max-width: 600px) {
    .payment-options {
      grid-template-columns: 1fr;
    }
  }
</style>
