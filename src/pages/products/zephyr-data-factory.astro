---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/homepage/Navbar.astro";
import Footer from "../../components/shared/Footer.astro";
---

<BaseLayout
  title="Zephyr Data Factory — Dataset API"
  description="API subscription service for curated datasets. On-demand access to crypto OHLCV, on-chain metrics, and more."
>
  <Navbar />
  <main>
    <section class="product-hero">
      <div class="product-badge coming-soon">Coming Soon</div>
      <h1>Zephyr Data Factory</h1>
      <p class="product-tagline">Dataset API Subscription — Programmatic Access to Curated Data</p>
      <a href="#notify" class="btn-primary">Notify Me</a>
    </section>

    <section class="product-section">
      <h2>Overview</h2>
      <p>
        Zephyr Data Factory is the API layer for Zephyr's curated datasets. Instead of downloading
        static files, subscribe to programmatic access — always up-to-date, always consistent.
      </p>
      <p>
        Built on Cloudflare Workers for global low-latency delivery, with built-in authentication,
        rate limiting, and usage-based billing — payable via invoice, card subscription, or
        native agent-to-agent payment, depending on how you're calling it.
      </p>
    </section>

    <section class="product-section">
      <h2>MCP Tools (MVP Ready)</h2>
      <ul class="feature-list">
        <li><strong>list_chains</strong> — List all available chains with row counts and date ranges</li>
        <li><strong>query_ohlcv</strong> — Query OHLCV data by chain, symbol, timeframe, and date range</li>
        <li><strong>get_stats</strong> — Aggregated statistics (min/max/avg price, volume, outlier count)</li>
        <li><strong>DuckDB Engine</strong> — Direct Parquet querying, zero ETL, sub-second response</li>
      </ul>
    </section>

    <section class="product-section">
      <h2>Roadmap</h2>
      <ul class="feature-list">
        <li><strong>Cloudflare Worker</strong> — Global edge deployment for low-latency access</li>
        <li><strong>MCP Protocol</strong> — Native Claude/Cursor integration via MCP stdio</li>
        <li><strong>Daily Updates</strong> — Automated incremental data refresh via GitHub Actions</li>
      </ul>
    </section>

    <section class="product-section" id="payment">
      <h2>Payment Options</h2>
      <p>
        Three ways to pay, matched to how you're using Data Factory — human subscriber,
        AI agent caller, or enterprise procurement.
      </p>
      <div class="payment-options payment-options-triple">
        <div class="payment-card">
          <h3>Wire Transfer / Invoice</h3>
          <p class="payment-note">Best for large B2B orders and procurement processes requiring a formal invoice.</p>
          <a href="mailto:orders@zephyrdn.com?subject=Zephyr Data Factory — Invoice Inquiry" class="btn-secondary">Contact for Invoice →</a>
        </div>
        <div class="payment-card">
          <h3>Card / Subscription (Paddle)</h3>
          <p class="payment-note">For individual subscribers who prefer card payment. Hosted checkout is pending provider approval.</p>
          <span class="btn-disabled">Coming soon — checkout pending approval</span>
        </div>
        <div class="payment-card">
          <h3>Agent Pay-Per-Call (x402)</h3>
          <p class="payment-note">Native per-request payment for AI agents calling our MCP tools directly. Protocol integration in progress.</p>
          <span class="btn-disabled">Coming soon — integration in progress</span>
        </div>
      </div>
    </section>

    <section class="product-section pricing">
      <h2>Pricing</h2>
      <div class="price-card">
        <span class="price">$49<span class="price-unit">/mo</span></span>
        <span class="price-note">Estimated. Launch pricing TBD.</span>
      </div>
      <a href="#notify" class="btn-primary">Get Notified at Launch →</a>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 5rem 1rem 2rem;
  }
  .product-hero {
    text-align: center;
    padding: 3rem 0 2rem;
  }
  .product-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .coming-soon {
    background: rgba(255, 149, 0, 0.12);
    color: #c77c00;
  }
  .product-hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }
  .product-tagline {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .product-section {
    padding: 2rem 0;
    border-top: 1px solid var(--color-border-soft);
  }
  .product-section h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .product-section p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }
  .feature-list {
    list-style: none;
    padding: 0;
  }
  .feature-list li {
    padding: 0.5rem 0;
    color: var(--color-text-muted);
  }
  .pricing {
    text-align: center;
  }
  .price-card {
    margin-bottom: 1.5rem;
  }
  .price {
    font-size: 3rem;
    font-weight: 800;
    display: block;
  }
  .price-unit {
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-text-faint);
  }
  .price-note {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .payment-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .payment-options-triple {
    grid-template-columns: repeat(3, 1fr);
  }
  .payment-card {
    padding: 1.25rem;
    background: var(--color-card);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
  }
  .payment-card h3 {
    font-size: 1rem;
    color: var(--color-white);
    margin-bottom: 0.6rem;
  }
  .payment-note {
    font-size: 0.85rem;
    color: var(--color-text-faint);
    margin-bottom: 1rem;
  }
  .btn-disabled {
    display: inline-block;
    text-align: center;
    background: transparent;
    color: var(--color-text-faint);
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
  }
  @media (max-width: 700px) {
    .payment-options-triple {
      grid-template-columns: 1fr;
    }
  }
</style>