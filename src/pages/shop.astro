---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/homepage/Navbar.astro";
import Footer from "../components/shared/Footer.astro";
---

<BaseLayout
  title="Shop | Zephyr"
  description="Curated data products for AI builders — real-world datasets, MCP APIs, and ready-to-train starter packs. Sourced, verified, documented."
>
  <Navbar />
  <main>
    <section class="shop-hero">
      <h1>Data Products</h1>
      <p>Curated datasets and tools for AI builders and crypto researchers. Every product ships with license clarity, update frequency, and full provenance.</p>
    </section>

    <section class="shop-section" id="real-world">
      <div class="section-badge">Verified</div>
      <h2>Real-World Data</h2>
      <p class="section-desc">Data sourced from real-world systems — exchanges, government agencies, financial filings. AI models generate this on their own. Multi-source aligned, outlier-filtered, with full provenance.</p>
      <div class="products">
        <article class="product-card">
          <div class="product-tag available">Available</div>
          <h2><a href="/products/zephyr-forge">Zephyr Forge</a></h2>
          <p class="product-origin">Curated crypto OHLCV dataset for niche chains. Multi-exchange aligned, AI-ready Parquet files with full provenance.</p>
          <ul>
            <li>SUI, APT, ARB, OP — 1h, 4h, 1d candles</li>
            <li>Binance, OKX, Bybit, Coinbase — median aligned</li>
            <li>421,918 rows · 2023-01 to 2026-07 · Parquet</li>
            <li>Provenance report + NO-PII compliance included</li>
          </ul>
          <div class="product-footer">
            <span class="price">$29</span>
            <a href="/products/zephyr-forge" class="btn-detail">Details</a>
            <a href="/products/zephyr-forge#payment" class="btn-buy">Get Now →</a>
          </div>
        </article>

        <article class="product-card">
          <div class="product-tag coming">Coming Soon</div>
          <h2>Data Factory API</h2>
          <p class="product-origin">MCP gateway for AI agents. Programmatic access to curated data via Claude, Cursor, and AutoGPT.</p>
          <ul>
            <li>REST + MCP — query by chain, symbol, timeframe</li>
            <li>Incremental daily updates via delta endpoints</li>
            <li>JSON, Parquet, CSV output</li>
            <li>Usage-based billing with monthly caps</li>
          </ul>
          <div class="product-footer">
            <span class="price">$49<span class="price-unit">/mo</span></span>
            <a href="/products/zephyr-data-factory" class="btn-buy">Learn More →</a>
          </div>
        </article>

      </div>
    </section>

    <section class="shop-note">
      <p>Questions? Email <a href="mailto:Yakovxia@gmail.com">Yakovxia@gmail.com</a></p>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  main { max-width: 960px; margin: 0 auto; padding: 2rem 1rem; }
  .shop-hero { text-align: center; padding: 3rem 0 2rem; }
  .shop-hero h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; }
  .shop-hero p { font-size: 1.1rem; color: var(--color-text-muted); }
  .shop-section { padding: 2rem 0; border-top: 1px solid var(--color-border-soft); }
  .section-badge { display: inline-block; padding: 0.15rem 0.6rem; border-radius: 4px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem; background: var(--color-blue); color: #fff; }
  .shop-section h2 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; }
  .section-desc { color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 1.5rem; max-width: 640px; line-height: 1.5; }
  .products { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; padding: 1rem 0; }
  .product-card { border: 1px solid var(--color-border-soft); border-radius: 10px; padding: 1.5rem; position: relative; background: var(--color-card); }
  .product-tag { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.75rem; }
  .available { background: #22c55e; color: #fff; }
  .coming { background: #f59e0b; color: #fff; }
  .product-card h2 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .product-card h2 a { color: inherit; text-decoration: none; }
  .product-card h2 a:hover { color: var(--color-blue); }
  .product-origin { color: var(--color-text-muted); font-style: italic; margin-bottom: 1rem; font-size: 0.9rem; line-height: 1.5; }
  .product-card ul { padding-left: 1.2rem; margin-bottom: 1.5rem; color: var(--color-text-muted); }
  .product-card ul li { margin-bottom: 0.3rem; font-size: 0.9rem; }
  .product-footer { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--color-border-soft); padding-top: 1rem; flex-wrap: wrap; gap: 0.5rem; }
  .price { font-size: 1.5rem; font-weight: 800; }
  .price-unit { font-size: 0.85rem; font-weight: 400; color: var(--color-text-faint); }
  .btn-buy { background: var(--color-white); color: #000; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .btn-detail { background: transparent; color: var(--color-text-muted); padding: 0.5rem 0.75rem; border: 1px solid var(--color-border-soft); border-radius: 6px; text-decoration: none; font-weight: 500; font-size: 0.85rem; }
  .btn-detail:hover { color: var(--color-white); border-color: var(--color-text-muted); }
  .shop-note { text-align: center; padding: 2rem 0; color: var(--color-text-muted); }
  @media (max-width: 768px) { .products { grid-template-columns: 1fr; } }
</style>
