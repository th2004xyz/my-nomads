---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/homepage/Navbar.astro';
import Footer from '../components/shared/Footer.astro';
---

<BaseLayout
  title="Shop | Zephyr"
  description="Curated data products — crypto datasets, APIs, and AI tools for builders and researchers."
>
  <Navbar />
  <main>
			<section class="shop-hero">
				<h1>Data Products</h1>
				<p>Curated datasets and tools for AI builders and crypto researchers.</p>
			</section>

			<section class="products">
				<article class="product-card">
					<div class="product-tag available">Available</div>
					<h2>Crypto OHLCV Dataset</h2>
					<p class="product-origin">Niche chain OHLCV data — 4 chains, 4 exchanges, 3 timeframes. Multi-exchange aligned with full provenance.</p>
					<ul>
						<li>SUI, APT, ARB, OP — 1h, 4h, 1d candles</li>
						<li>Binance, OKX, Bybit, Coinbase — median aligned</li>
						<li>414,427 rows · 2023-01 to 2024-07 · Parquet</li>
						<li>Provenance report + NO-PII compliance included</li>
					</ul>
					<div class="product-footer">
						<span class="price">$29</span>
						<a href="https://gumroad.com" target="_blank" class="btn-buy">Get Now →</a>
					</div>
				</article>

				<article class="product-card">
					<div class="product-tag coming">Coming Soon</div>
					<h2>Data API Subscription</h2>
					<p class="product-origin">Programmatic access to curated datasets. Always up-to-date, pay for what you use.</p>
					<ul>
						<li>REST API — query by chain, symbol, timeframe</li>
						<li>Incremental daily updates</li>
						<li>JSON, Parquet, CSV output</li>
						<li>Usage-based billing with monthly caps</li>
					</ul>
					<div class="product-footer">
						<span class="price">$49<span class="price-unit">/mo</span></span>
						<a href="/products/zephyr-data-factory" class="btn-buy">Learn More →</a>
					</div>
				</article>

				<article class="product-card">
					<div class="product-tag coming">Coming Soon</div>
					<h2>Zeph-Trans</h2>
					<p class="product-origin">Crypto industry translation tool — understands blockchain context, not just words.</p>
					<ul>
						<li>Domain-aware crypto terminology translation</li>
						<li>Multi-model: Claude, DeepSeek, GPT-4, Gemini</li>
						<li>Custom glossary management</li>
						<li>Markdown & code formatting preserved</li>
					</ul>
					<div class="product-footer">
						<span class="price">$9<span class="price-unit">/mo</span></span>
						<a href="/products/zeph-trans" class="btn-buy">Learn More →</a>
					</div>
				</article>
			</section>

			<section class="shop-note">
				<p>Questions? Email <a href="mailto:Yakovxia@gmail.com">Yakovxia@gmail.com</a></p>
			</section>
		</main>
  <Footer />
</BaseLayout>

<style>
	main {
		max-width: 960px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	.shop-hero {
		text-align: center;
		padding: 3rem 0 2rem;
	}
	.shop-hero h1 {
		font-size: 2.5rem;
		font-weight: 800;
		margin-bottom: 1rem;
	}
	.shop-hero p {
		font-size: 1.1rem;
		color: #666;
	}
	.products {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		padding: 2rem 0;
	}
	.product-card {
		border: 1px solid #eee;
		border-radius: 10px;
		padding: 1.5rem;
		position: relative;
	}
	.product-tag {
		display: inline-block;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		font-size: 0.8rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
	}
	.available {
		background: #22c55e;
		color: #fff;
	}
	.coming {
		background: #f59e0b;
		color: #fff;
	}
	.product-card h2 {
		font-size: 1.2rem;
		margin-bottom: 0.5rem;
	}
	.product-origin {
		color: #666;
		font-style: italic;
		margin-bottom: 1rem;
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.product-card ul {
		padding-left: 1.2rem;
		margin-bottom: 1.5rem;
		color: #444;
	}
	.product-card ul li {
		margin-bottom: 0.3rem;
		font-size: 0.9rem;
	}
	.product-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid #eee;
		padding-top: 1rem;
	}
	.price {
		font-size: 1.5rem;
		font-weight: 800;
	}
	.price-unit {
		font-size: 0.85rem;
		font-weight: 400;
		color: #888;
	}
	.btn-buy {
		background: #000;
		color: #fff;
		padding: 0.5rem 1rem;
		border-radius: 6px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
	}
	.shop-note {
		text-align: center;
		padding: 2rem 0;
		color: #666;
	}
</style>