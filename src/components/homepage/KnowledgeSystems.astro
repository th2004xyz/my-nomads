---
// src/components/KnowledgeSystems.astro
// Section 04 — curated AI signals, GitHub discoveries, and workflow foundations.
// Data is static for now; scalable toward content collections later.

interface KnowledgeItem {
  typeIcon: string;
  typeLabel: string;
  title: string;
  description: string;
  tags: string[];
  linkLabel: string;
  href: string;
  techStack?: string[];
}

const items: KnowledgeItem[] = [
  {
    typeIcon: "📡",
    typeLabel: "AI Signal #001",
    title: "Claude 3.7: What You Can Actually Build",
    description:
      "Not a feature list. A practical breakdown of how this update changes solo creator workflows.",
    tags: ["#signal", "#workflow"],
    linkLabel: "Read →",
    href: "#",
  },
  {
    typeIcon: "🐙",
    typeLabel: "GitHub Discovery #001",
    title: "Auto-SOP Generator",
    description:
      "Turn Loom videos into documented workflows using Whisper + AI. Open source & battle-tested.",
    tags: ["#open-source", "#automation"],
    linkLabel: "View Repo →",
    href: "#",
    techStack: ["Python", "Whisper", "Next.js"],
  },
  {
    typeIcon: "📚",
    typeLabel: "Workflow Basics #001",
    title: "The Creator's AI Leverage Framework",
    description:
      "A simple mental model for deciding when (and when not) to use AI in your daily operations.",
    tags: ["#beginner-friendly", "#systems-thinking"],
    linkLabel: "Learn →",
    href: "#",
  },
  {
    typeIcon: "🛠️",
    typeLabel: "Free System #001",
    title: "Personal Knowledge Dashboard",
    description:
      "A lightweight template to track AI experiments, prompts, and workflow iterations.",
    tags: ["#free", "#templates"],
    linkLabel: "Download →",
    href: "#",
  },
];
---

<section class="section" id="knowledge">
  <div class="section-header">
    <div class="section-label">Curated, Not Cluttered</div>
    <h2 class="section-title">AI Signals & Systems</h2>
    <p class="section-subtitle">
      No news feeds. Only high-signal patterns, discoveries, and foundations I
      actually use.
    </p>
  </div>

  <div class="card-grid">
    {items.map((item) => (
      <div class="card knowledge-card">
        <div class="knowledge-type">
          <span>{item.typeIcon}</span>
          <span>{item.typeLabel}</span>
        </div>

        <h3>{item.title}</h3>
        <p>{item.description}</p>

        {item.techStack && item.techStack.length > 0 && (
          <div class="tech-stack" style="margin-top: 0.6rem;">
            {item.techStack.map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        )}

        <div class="knowledge-meta">
          <div class="knowledge-tags">
            {item.tags.map((tag) => (
              <span class="knowledge-tag">{tag}</span>
            ))}
          </div>
          <a href={item.href} class="knowledge-link">{item.linkLabel}</a>
        </div>
      </div>
    ))}
  </div>
</section>
