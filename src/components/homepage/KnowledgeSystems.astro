---
// src/components/KnowledgeSystems.astro
// Section 04 — curated AI signals, GitHub discoveries, and workflow foundations.
// Data is static for now; scalable toward content collections later.

interface KnowledgeItem {
  typeIcon: string;
  typeLabel: string;
  title: string;
  description: string;
  tags: string[];
  linkLabel: string;
  href: string;
  techStack?: string[];
}

const items: KnowledgeItem[] = [
  {
    typeIcon: "📡",
    typeLabel: "AI Workflow #001",
    title: "Claude 3.7: What You Can Actually Build",
    description:
      "Not a feature list. A practical breakdown of how this update changes solo creator workflows.",
    tags: ["#workflow", "#claude"],
    linkLabel: "Read →",
    href: "#",
  },
  {
    typeIcon: "🐙",
    typeLabel: "GitHub Find #001",
    title: "Auto-SOP Generator",
    description:
      "Turn Loom videos into documented workflows using Whisper + AI. Open source and worth exploring.",
    tags: ["#open-source", "#automation"],
    linkLabel: "View Repo →",
    href: "#",
    techStack: ["Python", "Whisper", "Next.js"],
  },
  {
    typeIcon: "📚",
    typeLabel: "Mental Model #001",
    title: "When to Use AI (and When Not To)",
    description:
      "A simple framework for deciding which parts of your workflow AI should actually touch.",
    tags: ["#systems", "#clarity"],
    linkLabel: "Read →",
    href: "#",
  },
  {
    typeIcon: "🛠️",
    typeLabel: "Free Template #001",
    title: "Personal AI Experiment Tracker",
    description:
      "A lightweight Notion template to log prompts, tools, and what worked — so you stop repeating yourself.",
    tags: ["#free", "#templates"],
    linkLabel: "Download →",
    href: "#",
  },
];
---

<section class="section" id="knowledge">
  <div class="section-header">
    <div class="section-label">Things I'm Finding Useful</div>
    <h2 class="section-title">Workflows & Discoveries</h2>
    <p class="section-subtitle">
      Patterns, tools, and ideas I've actually tested — shared as I go.
    </p>
  </div>

  <div class="card-grid">
    {items.map((item) => (
      <div class="card knowledge-card">
        <div class="knowledge-type">
          <span>{item.typeIcon}</span>
          <span>{item.typeLabel}</span>
        </div>

        <h3>{item.title}</h3>
        <p>{item.description}</p>

        {item.techStack && item.techStack.length > 0 && (
          <div class="tech-stack" style="margin-top: 0.6rem;">
            {item.techStack.map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        )}

        <div class="knowledge-meta">
          <div class="knowledge-tags">
            {item.tags.map((tag) => (
              <span class="knowledge-tag">{tag}</span>
            ))}
          </div>
          <a href={item.href} class="knowledge-link">{item.linkLabel}</a>
        </div>
      </div>
    ))}
  </div>
</section>
