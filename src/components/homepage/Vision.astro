---
// src/components/Vision.astro
// Section 02 — benefit-focused feature cards.

const features = [
  {
    icon: "📋",
    title: "Organize Your AI Workflow",
    description:
      "Stop drowning in tabs. Structure your prompts, tools, and outputs into repeatable systems.",
  },
  {
    icon: "🏗️",
    title: "Build a One-Person Business",
    description:
      "From idea to execution. Calm, focused operations designed for solo creators who want to ship.",
  },
  {
    icon: "🔍",
    title: "Discover What Actually Works",
    description:
      "No hype. Only patterns and tools I've tested myself — shared as I build.",
  },
  {
    icon: "⚙️",
    title: "Automate the Repetitive Parts",
    description:
      "Content pipelines, research flows, admin tasks — delegated to AI so you can focus on what matters.",
  },
];
---

<section class="section" id="vision">
  <div class="section-header">
    <div class="section-label">What This Is About</div>
    <h2 class="section-title">AI Workflows for Solo Builders</h2>
  </div>

  <div class="card-grid">
    {features.map((f) => (
      <div class="card feature-card">
        <div class="feature-icon">{f.icon}</div>
        <h3>{f.title}</h3>
        <p>{f.description}</p>
      </div>
    ))}
  </div>
</section>
