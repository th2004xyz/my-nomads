---
// src/components/RuntimeKits.astro
// Section 04b — upcoming workflow kits, anchored below KnowledgeSystems.
// Currently in development — shown as "coming soon" to stay honest.

interface Kit {
  typeIcon: string;
  typeLabel: string;
  title: string;
  description: string;
  features: string[];
  status: string;
  linkLabel: string;
  href: string;
}

const kits: Kit[] = [
  {
    typeIcon: "🚀",
    typeLabel: "Coming Soon",
    title: "Solo Creator Workflow Kit",
    description:
      "A practical bundle of AI workflow templates, prompt structures, and checklists for running a one-person content operation.",
    features: [
      "AI workflow templates",
      "Content production checklists",
      "Prompt library starter pack",
    ],
    status: "In Progress — Building in Public",
    linkLabel: "Follow the Build →",
    href: "/builds",
  },
];
---

<div class="kits-divider" id="kits">
  <h3>🛠️ Workflow Kits</h3>
  <p>Practical, tested systems — built openly and shared when ready.</p>

  <div class="kits-grid">
    {kits.map((kit) => (
      <div class="card knowledge-card highlight-card">
        <div class="knowledge-type">
          <span>{kit.typeIcon}</span>
          <span>{kit.typeLabel}</span>
        </div>

        <h3>{kit.title}</h3>
        <p>{kit.description}</p>

        <div class="kit-features">
          {kit.features.map((f) => (
            <span>→ {f}</span>
          ))}
        </div>

        <div class="knowledge-meta">
          <span class="knowledge-tag">{kit.status}</span>
          <a href={kit.href} class="knowledge-link">{kit.linkLabel}</a>
        </div>
      </div>
    ))}
  </div>
</div>
