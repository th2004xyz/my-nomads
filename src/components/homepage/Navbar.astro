---
import { Image } from 'astro:assets';
import logo from '../../assets/zephyr-logo.png';

const navLinks = [
  { label: "Forge",        href: "/products/zephyr-forge"        },
  { label: "Data Factory", href: "/products/zephyr-data-factory" },
  { label: "Translate",    href: "/products/zephyr-translate"    },
  { label: "About",        href: "/about"                         },
];
---

<nav class="nav">
  <div class="nav-container">
    <a href="/" class="nav-logo">
      <Image src={logo} alt="Zephyr" class="nav-logo-img" width={28} height={28} />
      Zephyr
    </a>
    <div class="nav-links">
      {navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </div>
  </div>
</nav>
