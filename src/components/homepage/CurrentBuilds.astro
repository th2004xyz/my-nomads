---
import { getCollection } from 'astro:content';

const nowBuilding = [
  'Zephyr Nomad Runtime Kit',
  'OneManCompany Simplified Installer',
  'AI Creator Workflow Pack',
  'GitHub Discovery Engine',
];

const badgeLabels: Record<string, string> = {
  log: '📓 Build Log',
  experiment: '🧪 Build Log',
  shipped: '🚀 Shipped',
  discovery: '🐙 Discovery',
};

const allBuilds = await getCollection('builds');
const builds = [...allBuilds]
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map((entry, index) => ({
    id: entry.id,
    href: `/builds/${entry.id}/`,
    badgeType: entry.data.badgeType,
    badgeLabel: badgeLabels[entry.data.badgeType] ?? badgeLabels.log,
    timeAgo: entry.data.pubDate.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }),
    title: entry.data.title,
    description: entry.data.description,
    index: String(allBuilds.length - index).padStart(3, '0'),
  }));
---

<section class="section" id="builds">
  <div class="section-header">
    <div class="section-label">Live Development</div>
    <h2 class="section-title">Current Builds</h2>
  </div>

  <div class="now-building">
    <h3>Now Building</h3>
    <div class="now-building-grid">
      {nowBuilding.map((item) => (
        <span class="building-tag">{item}</span>
      ))}
    </div>
  </div>

  <div class="card-grid">
    {builds.map((build) => (
      <a href={build.href} class="card build-card build-card-link">
        <div class="build-header">
          <span class={`build-badge badge-${build.badgeType}`}>
            {build.badgeLabel} #{build.index}
          </span>
          <span class="build-time">{build.timeAgo}</span>
        </div>

        <h3>{build.title}</h3>
        <p>{build.description}</p>

        <span class="build-read">Read build log →</span>
      </a>
    ))}
  </div>
</section>

<style>
  .build-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition), border-color var(--transition);
  }
  .build-card-link:hover {
    transform: translateY(-4px);
    border-color: rgba(77, 124, 254, 0.35);
  }
  .build-read {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-blue);
  }
</style>
