---
import { getCollection } from 'astro:content';

const nowBuilding = [
  'Zephyr Nomad Runtime Kit',
  'OneManCompany Simplified Installer',
  'AI Creator Workflow Pack',
  'GitHub Discovery Engine',
];

const allBuilds = await getCollection('builds');
const builds = [...allBuilds]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry, index) => ({
    id: entry.id,
    href: `/builds/${entry.id}`,
    badgeLabel: entry.data.tags[0] ?? 'build-log',
    timeAgo: entry.data.date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }),
    title: entry.data.title,
    summary: entry.data.summary,
    index: String(allBuilds.length - index).padStart(3, '0'),
  }));
---

<section class="section" id="builds">
  <div class="section-header">
    <div class="section-label">Live Development</div>
    <h2 class="section-title">Current Builds</h2>
  </div>

  <div class="now-building">
    <h3>Now Building</h3>
    <div class="now-building-grid">
      {nowBuilding.map((item) => (
        <span class="building-tag">{item}</span>
      ))}
    </div>
  </div>

  <div class="card-grid">
    {builds.map((build) => (
      <a href={build.href} class="card build-card build-card-link">
        <div class="build-header">
          <span class="build-badge badge-log">
            {build.badgeLabel} #{build.index}
          </span>
          <span class="build-time">{build.timeAgo}</span>
        </div>

        <h3>{build.title}</h3>
        <p>{build.summary}</p>

        <span class="build-read">Read build log →</span>
      </a>
    ))}
  </div>
</section>

<style>
  .build-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .build-read {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-blue);
  }
</style>
