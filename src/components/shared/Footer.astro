---
// Footer with sub-site links.
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <p>&copy; 2026 Zephyr — Data Products for AI Builders</p>
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <h4>Products</h4>
        <a href="/products/zephyr-forge">Forge</a>
        <a href="/products/zephyr-data-factory">Data Factory</a>
        <a href="/products/zephyr-translate">Zephyr Translate</a>
      </div>

      <div class="footer-col">
        <h4>Contact</h4>
        <a href="mailto:Yakovxia@gmail.com">Yakovxia@gmail.com</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--background-100);
    color: var(--text-500);
    padding: 3rem 1rem 2rem;
    margin-top: 4rem;
    border-top: 1px solid var(--color-border-soft);
  }
  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .footer-brand {
    border-bottom: 1px solid var(--color-border-soft);
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .footer-brand p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-500);
  }
  .footer-links {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
  }
  .footer-col h4 {
    color: var(--foreground);
    font-family: var(--font-serif);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }
  .footer-col a {
    display: block;
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.2rem 0;
    transition: color var(--transition);
  }
  .footer-col a:hover {
    color: var(--primary);
  }
</style>
