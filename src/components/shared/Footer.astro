    padding: 3rem 1rem 2rem;
    margin-top: 4rem;
  }
  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
  }
  .footer-brand {
    border-bottom: 1px solid #333;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .footer-brand p {
    margin: 0;
    font-size: 0.95rem;
  }
  .footer-links {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
  }
  .footer-col h4 {
    color: #fff;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }
  .footer-col a {
    display: block;
    color: #999;
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.2rem 0;
  }
  .footer-col a:hover {
    color: #fff;
