---
import BaseHead from '../components/BaseHead.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
}

const {
  title = 'Zephyr — AI-Native Digital Life Hub',
  description =
    'Curated crypto datasets, data APIs, and domain-specific AI tools for researchers, quants, and builders.',
  image,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body>
    <slot />
  </body>
</html>
